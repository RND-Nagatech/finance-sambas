PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/finance_sambas
CORS_ORIGIN=http://localhost:5173

# Sumber satu akun awal untuk `npm run seed`.
# Setelah di-seed, login membaca user dari collection tm_user.
AUTH_ENABLED=true
AUTH_SESSION_TTL_HOURS=12
AUTH_SUPER_USERNAME=superuser
AUTH_SUPER_PASSWORD=ubah-password-ini
AUTH_SUPER_NAME=Super User Finance

# Migrasi satu kali dari collection prototype lama tm_akun/tm_bank.
# Default false agar data lama tidak otomatis dibuat ulang ke master baru.
LEGACY_MASTER_MIGRATION_ENABLED=false

# Koneksi cluster MongoDB Nagagold yang digunakan bersama oleh semua cabang.
# Nama database masing-masing cabang disimpan di collection tm_cabang.
NAGAGOLD_MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
# Bila database OPTIK berada pada cluster berbeda, isi URI ini. Jika kosong,
# Finance memakai NAGAGOLD_MONGODB_URI dengan database_name dari tm_cabang.
OPTIK_MONGODB_URI=

# Finance membaca tt_cash_daily langsung dari database Nagagold setiap cabang.
# database_name cabang disimpan di tm_cabang, bukan di env.
NAGAGOLD_SYNC_ENABLED=false
NAGAGOLD_SYNC_INTERVAL_MINUTES=10
NAGAGOLD_SYNC_LOOKBACK_MINUTES=2
NAGAGOLD_SYNC_INITIAL_LOOKBACK_MINUTES=60
# Isi jika sinkronisasi pertama ingin dimulai dari waktu tertentu.
# Contoh: 2026-10-29T00:00:00+07:00
NAGAGOLD_SYNC_INITIAL_FROM=
NAGAGOLD_SYNC_RECONCILE_DAYS=3
NAGAGOLD_SYNC_LIMIT=1000
# Mode dekripsi resmi yang digunakan aplikasi Nagagold saat membaca snapshot sumber.
NAGAGOLD_ENCRYPTION_MODE=1
NAGAGOLD_DECRYPTION_KEY=
# OPTIK menggunakan field terenkripsi pada jenis/kategori dengan mekanisme key
# yang sama bentuknya. Isi key sumber OPTIK sesuai konfigurasi aplikasi OPTIK.
OPTIK_ENCRYPTION_MODE=1
OPTIK_DECRYPTION_KEY=
OPTIK_SYNC_LIMIT=1000
# Tahap 5: whitelist auto-posting tetap nonaktif sampai aturan bisnis,
# finalitas, mapping, dry-run, dan persetujuan Owner/Super User selesai.
NAGAGOLD_AUTO_POSTING_ENABLED=false
# Transaksi Nagagold yang sudah tervalidasi kasir dan mapping rekeningnya unik
# akan langsung dibukukan ke Finance tanpa approval kedua.
NAGAGOLD_SOURCE_POSTING_ENABLED=true
